{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist-scripts",
    "rootDir": ".",
    "lib": ["ES2022"],
    "types": []
  },
  "include": ["src/core/**/*", "src/shared/**/*", "scripts/**/*"],
  "exclude": ["node_modules", "dist"]
}
