{
  "manifest_version": 3,
  "name": "qbcheck",
  "version": "0.1.0",
  "description": "Lint quizbowl question packets for QMOS style violations",
  "permissions": ["storage", "clipboardRead"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "qbcheck"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
